{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/news-sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/article/:id",
      "destination": "/api/render-article?id=:id"
    },
    {
      "source": "/magazine/:id",
      "destination": "/api/render-magazine?id=:id"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/manus-storage?path=:path*"
    },
    {
      "source": "/api/manus-storage/:path*",
      "destination": "/api/manus-storage?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
